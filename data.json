  "faq": [
    {
      "q": "How does the lottery work?",
      "a": "Enter during the lottery window and pay only if you win. Results are emailed after the window closes, and winning entries are charged automatically to the card on file."
    },
    {
      "q": "When do general sale tickets go live?",
      "a": "Any tickets left after the lottery rounds move to general sale, first come first served. Events marked Coming soon do not have an on-sale date yet."
    },
    {
      "q": "Can I transfer or resell a ticket?",
      "a": "Sold out events may reopen through official resale when other buyers release seats. Private resale is not supported."
    }
  ]
